{
  "name": "grupo-de-negocios",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Grupo Inconecta — gestão de membros e caixa com identidade ESTELA e banco Turso",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:bootstrap": "node scripts/bootstrap-admin.js",
    "db:check": "node scripts/check-db.js",
    "generate:secret": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('hex'))\"",
    "test": "node --test tests/*.test.js",
    "check:syntax": "node scripts/check-syntax.js",
    "db:seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0"
  }
}
